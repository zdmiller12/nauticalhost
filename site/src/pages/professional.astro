---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { skills } from '../data/skills';

const entries = await getCollection('experience');

const jobs = entries
  .filter((entry) => entry.data.type === 'job')
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const education = entries
  .filter((entry) => entry.data.type === 'education')
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const certifications = entries
  .filter((entry) => entry.data.type === 'certification')
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

const formatYear = (date: Date) => date.getUTCFullYear().toString();
const formatJobDates = (start: Date, end: Date | null) =>
  `${formatYear(start)}–${end ? formatYear(end) : 'present'}`;

const resumeData = { certifications, education, jobs, skills };
---
<BaseLayout title="Professional" description="Zack Miller's professional experience.">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold">Professional</h1>
    <button
      id="export-pdf"
      type="button"
      class="rounded border border-line px-3 py-1.5 text-sm hover:text-clay"
    >
      Export as PDF
    </button>
  </div>

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Experience</h2>
    <ul class="mt-2 space-y-3">
      {jobs.map((job) => (
        <li>
          <p class="text-ink">
            <span class="font-medium">{job.title}</span> — {job.organization}
            {job.location && <span class="text-ink-muted"> ({job.location})</span>}
          </p>
          <p class="text-sm text-ink-muted">{formatJobDates(job.startDate, job.endDate)}</p>
          {job.bullets.length > 0 && (
            <ul class="mt-1 list-disc space-y-1 pl-5 text-ink-muted">
              {job.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Education</h2>
    <ul class="mt-2 space-y-1 text-ink-muted">
      {education.map((item) => (
        <li>{item.degree} — {item.institution}, {formatYear(item.graduationDate)}</li>
      ))}
    </ul>
  </section>

  {certifications.length > 0 && (
    <section class="mt-8">
      <h2 class="text-lg font-semibold">Certifications</h2>
      <ul class="mt-2 space-y-1 text-ink-muted">
        {certifications.map((cert) => (
          <li>{cert.name} — {cert.issuer}, {formatYear(cert.dateEarned)}</li>
        ))}
      </ul>
    </section>
  )}

  <section class="mt-8">
    <h2 class="text-lg font-semibold">Skills</h2>
    <ul class="mt-2 flex flex-wrap gap-2">
      {skills.map((skill) => (
        <li class="rounded-full bg-line/50 px-3 py-1 text-xs text-ink-muted">{skill}</li>
      ))}
    </ul>
  </section>

  <script type="application/json" id="resume-data" set:html={JSON.stringify(resumeData)} />
  <script src="../scripts/resume-pdf.ts"></script>
</BaseLayout>
