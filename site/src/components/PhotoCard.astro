---
import type { CollectionEntry } from 'astro:content';
import TierBadge from './TierBadge.astro';
import { photoCardId, photoHref } from '../lib/compendium-routes';
import { objectName, photoTitle } from '../lib/photo-display';
import { DEFAULT_SORT } from '../lib/photo-sort';

interface Props {
  photo: CollectionEntry<'photos'>;
  r2Base: string;
}

const { photo, r2Base } = Astro.props;
const { file, datetime, tier, notes, objects, slug } = photo.data;
---
<li id={photoCardId(slug)}>
  <a
    href={photoHref(slug, DEFAULT_SORT)}
    data-photo-link={slug}
    class="block h-full rounded-lg border border-line bg-paper p-3 shadow-sm transition-colors hover:border-clay focus-visible:border-clay focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay"
  >
    <img
      src={`${r2Base}/${file}-thumb.jpg`}
      alt={notes ?? photoTitle(objects)}
      loading="lazy"
      class="w-full rounded-md object-cover"
    />
    <p class="mt-2 flex items-center justify-between text-xs text-ink-muted">
      <span>{datetime.toISOString().slice(0, 10)}</span>
      <TierBadge tier={tier} />
    </p>
    <ul class="mt-2 flex flex-wrap gap-1">
      {objects.map((obj) => (
        <li class="rounded-full bg-line/50 px-2 py-0.5 text-xs text-ink-muted">{objectName(obj)}</li>
      ))}
    </ul>
  </a>
</li>
