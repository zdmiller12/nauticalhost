---
import { compendiumHref, photoHref } from '../lib/compendium-routes';
import { DEFAULT_SORT, SORT_LABELS, type SortNav } from '../lib/photo-sort';

interface Props {
  navs: SortNav[];
  slug: string;
}

const { navs, slug } = Astro.props;

const linkClass = 'text-clay hover:underline hover:underline-offset-4';
const disabledClass = 'text-ink-muted/50';
---
{navs.map(({ index, key, next, prev, total }) => (
  <nav
    data-sort-nav={key}
    hidden={key !== DEFAULT_SORT}
    aria-label="Photo navigation"
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-sm"
  >
    <a href={compendiumHref(key, slug)} class={linkClass}>&larr; Compendium</a>
    <div class="flex items-center gap-4">
      {prev ? (
        <a href={photoHref(prev.slug, key)} rel="prev" title={prev.title} class={linkClass}>&lsaquo; Previous</a>
      ) : (
        <span class={disabledClass}>&lsaquo; Previous</span>
      )}
      <span class="text-ink-muted tabular-nums">
        {index + 1} of {total}
        <span class="hidden sm:inline">· by {SORT_LABELS[key].toLowerCase()}</span>
      </span>
      {next ? (
        <a href={photoHref(next.slug, key)} rel="next" title={next.title} class={linkClass}>Next &rsaquo;</a>
      ) : (
        <span class={disabledClass}>Next &rsaquo;</span>
      )}
    </div>
  </nav>
))}
<script src="../scripts/photo-nav.ts"></script>
